{
  "name": "course-platform",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run version:check && tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "materials:audit": "node --experimental-strip-types scripts/materials.mjs audit",
    "materials:sync": "node --experimental-strip-types scripts/materials.mjs sync-catalog",
    "materials:studio": "node --experimental-strip-types scripts/materials-studio.mjs",
    "materials:build": "node --experimental-strip-types scripts/materials-build.mjs",
    "materials:preview": "node --experimental-strip-types scripts/materials-build.mjs --preview",
    "materials:shots": "node scripts/materials-shots.mjs",
    "check": "npm test && npm run build && npm --prefix functions run build && npm --prefix functions test"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
