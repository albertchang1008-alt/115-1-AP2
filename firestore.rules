rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /courses/{courseId}/auditLog/{entryId} {
      allow read: if request.auth != null && request.auth.token.teacher == true
        && request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.teacherIds;
      allow write: if false;
    }
    // Reflections contain named student responses; access only through authorized callables.
    match /courses/{courseId}/reflections/{activityKey}/responses/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
