rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /courses/{courseId}/auditLog/{entryId} {
      allow read: if request.auth != null && request.auth.token.teacher == true
        && request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.teacherIds;
      allow write: if false;
    }
    // Reflections contain named student responses; access only through authorized callables.
    match /courses/{courseId}/reflections/{activityKey}/responses/{uid} { allow read, write: if false; }
    // 課堂點名（#67）：出缺席紀錄、修改紀錄、寄送紀錄、動態碼秘密值與寄信密鑰，一律只經由已授權的 callable 讀寫。
    match /courses/{courseId}/attendance/{document=**} { allow read, write: if false; }
    match /courses/{courseId}/attendanceState/{document=**} { allow read, write: if false; }
    match /courses/{courseId}/attendanceSecrets/{document=**} { allow read, write: if false; }
    match /courses/{courseId}/attendanceAudit/{document=**} { allow read, write: if false; }
    match /courses/{courseId}/attendanceMail/{document=**} { allow read, write: if false; }
    match /courses/{courseId}/attendanceConfig/{document=**} { allow read, write: if false; }
    function quizTeacher(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return request.auth != null && request.auth.token.teacher == true
        && request.auth.uid in course.teacherIds && course.features.zuvioExams == true;
    }
    function attendsQuizScope(scope) {
      let course = get(/databases/$(database)/documents/courses/$(scope.courseId)).data;
      let key = scope.courseId + '__' + request.auth.token.email.lower();
      let enrollment = get(/databases/$(database)/documents/enrollments/$(key)).data;
      return course.rosterVersion == 2 && course.features.zuvioExams == true
        && (!('archived' in course) || course.archived != true)
        && scope.classId in course.published.classIds
        && enrollment.enabled == true && enrollment.courseId == scope.courseId && enrollment.classId == scope.classId;
    }
    match /quizSignals/{key} {
      // An empty document carries no data. This permits the first announcement to reach an already-open home page.
      allow get: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (!('teacher' in request.auth.token) || request.auth.token.teacher != true)
        && (resource == null || attendsQuizScope(get(/databases/$(database)/documents/quizSignalScopes/$(key)).data));
      allow list, write: if false;
    }
    match /courses/{courseId}/platformQuizzes/{sittingId}/monitor/summary {
      allow get: if quizTeacher(courseId);
      allow list, write: if false;
    }
    match /courses/{courseId}/platformQuizzes/{sittingId}/events/{eventId} {
      allow get: if quizTeacher(courseId);
      allow list: if request.query.limit <= 500 && quizTeacher(courseId);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
