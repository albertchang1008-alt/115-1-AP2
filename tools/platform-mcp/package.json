{
  "name": "platform-mcp",
  "version": "1.10.2",
  "private": true,
  "type": "module",
  "bin": {
    "platform-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && npm test && npm run build",
